[Unit]
Description=ohmypi gateway (omp RPC hub)
After=network-online.target

[Service]
ExecStart=/home/jason/projects/ohmypi-gateway/.venv/bin/uvicorn gateway.main:app --host 0.0.0.0 --port 9315 --app-dir /home/jason/projects/ohmypi-gateway
WorkingDirectory=/home/jason/projects/ohmypi-gateway
Environment=PATH=/home/jason/.bun/bin:/usr/local/bin:/usr/local/sbin:/usr/bin
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
